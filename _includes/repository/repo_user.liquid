<div class="repo p-2">
  <a class="gh-card gh-user-card" href="https://github.com/{{ include.username }}" data-gh-user="{{ include.username }}">
    <img class="gh-user-avatar" alt="{{ include.username }}" src="https://github.com/{{ include.username }}.png?size=160">
    <div class="gh-user-body">
      <div class="gh-card-title">
        <span class="gh-user-name"><strong>{{ include.username }}</strong></span>
      </div>
      <div class="gh-user-login">@{{ include.username }}</div>
      <p class="gh-card-desc"></p>
      <div class="gh-card-meta"></div>
    </div>
  </a>
</div>
