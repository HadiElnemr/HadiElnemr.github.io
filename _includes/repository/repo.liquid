{% assign repo_url = include.repository | split: '/' %}
{% if site.data.repositories.github_users contains repo_url.first %}
  {% assign show_owner = false %}
{% else %}
  {% assign show_owner = true %}
{% endif %}

{% if site.data.repositories.repo_description_lines_max %}
  {% assign max_lines = site.data.repositories.repo_description_lines_max %}
{% else %}
  {% assign max_lines = 2 %}
{% endif %}

<div class="repo p-2">
  <a
    class="gh-card gh-repo-card"
    href="https://github.com/{{ include.repository }}"
    data-gh-repo="{{ include.repository }}"
    style="--gh-desc-lines: {{ max_lines }}"
  >
    <div class="gh-card-title">
      <i class="far fa-bookmark"></i>
      <span>{% if show_owner %}{{ repo_url[0] }}/{% endif %}<strong>{{ repo_url[1] }}</strong></span>
    </div>
    <p class="gh-card-desc"></p>
    <div class="gh-card-meta"></div>
  </a>
</div>
